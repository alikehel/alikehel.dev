{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "alikehel-dev",
    "main": "@tanstack/react-start/server-entry",
    "compatibility_date": "2026-09-10",
    "compatibility_flags": ["nodejs_compat"],
    "routes": [
        {
            "pattern": "alikehel.dev",
            "custom_domain": true,
        },
    ],
    "observability": {
        "enabled": true,
    },
}
